<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Plainstall.App.Views"
    xmlns:vm="clr-namespace:Plainstall.App.ViewModels"
    mc:Ignorable="d">

    <!--  The brand font, embedded. Only for the name and large headings. Body text stays in the system font.  -->
    <FontFamily x:Key="Plainstall.BrandFont">pack://application:,,,/Plainstall.App;component/Assets/Fonts/#Urbanist</FontFamily>

    <!--  Light defaults. BrandTheme replaces these at the application level for the active theme.  -->
    <SolidColorBrush x:Key="Plainstall.PageBackgroundBrush" Color="#F5ECC2" />
    <SolidColorBrush x:Key="Plainstall.TextBrush" Color="#111314" />
    <SolidColorBrush x:Key="Plainstall.TextSecondaryBrush" Color="#D0111314" />
    <SolidColorBrush x:Key="Plainstall.CardSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Plainstall.CardBorderBrush" Color="#90A1A39A" />
    <SolidColorBrush x:Key="Plainstall.AccentBrush" Color="#005B8D" />
    <SolidColorBrush x:Key="Plainstall.AccentTextBrush" Color="#005B8D" />
    <SolidColorBrush x:Key="Plainstall.InfoStripeBrush" Color="#005B8D" />
    <SolidColorBrush x:Key="Plainstall.CautionStripeBrush" Color="#E2B540" />
    <SolidColorBrush x:Key="Plainstall.DangerBrush" Color="#CC1236" />
    <SolidColorBrush x:Key="Plainstall.WordmarkLettersBrush" Color="#111314" />
    <SolidColorBrush x:Key="Plainstall.WordmarkIBrush" Color="#CC1236" />
    <SolidColorBrush x:Key="Plainstall.WordmarkNBrush" Color="#E2B540" />
    <SolidColorBrush x:Key="Plainstall.BadgeModerateBrush" Color="#E2B540" />
    <SolidColorBrush x:Key="Plainstall.BadgeModerateTextBrush" Color="#111314" />
    <SolidColorBrush x:Key="Plainstall.BadgeAdvancedBrush" Color="#111314" />
    <SolidColorBrush x:Key="Plainstall.BadgeAdvancedTextBrush" Color="#F5ECC2" />
    <SolidColorBrush x:Key="Plainstall.BadgeSafeBorderBrush" Color="#90111314" />
    <SolidColorBrush x:Key="Plainstall.StepDoneBrush" Color="#005B8D" />
    <SolidColorBrush x:Key="Plainstall.StepUpcomingBrush" Color="#A1A39A" />
    <SolidColorBrush x:Key="Plainstall.SubtleBrush" Color="#0C111314" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <views:FormatConverter x:Key="Format" />

    <!--  A visible keyboard focus on every custom template: a 2 px ring in the text colour.  -->
    <Style x:Key="Plainstall.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle
                        Margin="-3"
                        RadiusX="8"
                        RadiusY="8"
                        SnapsToDevicePixels="True"
                        Stroke="{DynamicResource Plainstall.TextBrush}"
                        StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Text  -->
    <Style x:Key="Plainstall.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Plainstall.BrandFont}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource Plainstall.TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Plainstall.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource Plainstall.TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="Plainstall.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Plainstall.TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Plainstall.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Plainstall.TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Plainstall.Secondary" BasedOn="{StaticResource Plainstall.Body}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Plainstall.TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <!--  The result of an action. Bind Tag to a flag that is true when the action failed. The text is then red.  -->
    <Style x:Key="Plainstall.Result" BasedOn="{StaticResource Plainstall.Body}" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Plainstall.DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Plainstall.Strong" BasedOn="{StaticResource Plainstall.Body}" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Plainstall.Bullet" BasedOn="{StaticResource Plainstall.Body}" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,2" />
    </Style>

    <!--  Surfaces  -->
    <Style x:Key="Plainstall.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Plainstall.CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Plainstall.CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!--  Notices: a stripe on the left and an icon with a title, so the kind is never told by colour alone.  -->
    <Style x:Key="Plainstall.Notice" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Plainstall.CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Plainstall.InfoStripeBrush}" />
        <Setter Property="BorderThickness" Value="5,1,1,1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style x:Key="Plainstall.Notice.Caution" BasedOn="{StaticResource Plainstall.Notice}" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Plainstall.CautionStripeBrush}" />
    </Style>
    <Style x:Key="Plainstall.Notice.Danger" BasedOn="{StaticResource Plainstall.Notice}" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Plainstall.DangerBrush}" />
    </Style>
    <Style x:Key="Plainstall.NoticeIcon" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource Plainstall.TextBrush}" />
    </Style>
    <Style x:Key="Plainstall.NoticeIcon.Danger" BasedOn="{StaticResource Plainstall.NoticeIcon}"
           TargetType="ui:SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource Plainstall.DangerBrush}" />
        <Setter Property="Filled" Value="True" />
    </Style>

    <!--  Risk badge: shape and word together. Used inside the catalog entry template, so the data is an EntryViewModel.  -->
    <Style
        x:Key="Plainstall.RiskBadge"
        d:Style.DataContext="{d:DesignInstance Type=vm:EntryViewModel}"
        TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource Plainstall.BadgeSafeBorderBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Risk}" Value="Moderate">
                <Setter Property="Background" Value="{DynamicResource Plainstall.BadgeModerateBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Plainstall.BadgeModerateBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Risk}" Value="Advanced">
                <Setter Property="Background" Value="{DynamicResource Plainstall.BadgeAdvancedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Plainstall.BadgeAdvancedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="Plainstall.RiskBadgeText"
        d:Style.DataContext="{d:DesignInstance Type=vm:EntryViewModel}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Plainstall.TextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Risk}" Value="Moderate">
                <Setter Property="Foreground" Value="{DynamicResource Plainstall.BadgeModerateTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Risk}" Value="Advanced">
                <Setter Property="Foreground" Value="{DynamicResource Plainstall.BadgeAdvancedTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  A large choice that behaves like a radio button: arrow keys move between cards, Space selects.  -->
    <Style x:Key="Plainstall.ChoiceCard" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Plainstall.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Plainstall.TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Card"
                        Padding="16,14"
                        Background="{DynamicResource Plainstall.CardSurfaceBrush}"
                        BorderBrush="{DynamicResource Plainstall.CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter />
                            <ui:SymbolIcon
                                x:Name="Check"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Top"
                                FontSize="22"
                                Foreground="{DynamicResource Plainstall.AccentTextBrush}"
                                Symbol="CheckmarkCircle24"
                                Filled="True"
                                Visibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush"
                                    Value="{DynamicResource Plainstall.AccentBrush}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="3" />
                            <Setter TargetName="Card" Property="Padding" Value="14,12" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background"
                                    Value="{DynamicResource Plainstall.SubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Card" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>