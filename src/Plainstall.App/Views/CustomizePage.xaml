<UserControl
    x:Class="Plainstall.App.Views.CustomizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:Plainstall.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Plainstall.App.Views"
    xmlns:vm="clr-namespace:Plainstall.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:CustomizeViewModel}"
    mc:Ignorable="d">
    <Grid Margin="32,12,32,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    AutomationProperties.Name="{x:Static res:Strings.Customize_ResetName}"
                    Command="{Binding ResetToPresetCommand}"
                    Content="{x:Static res:Strings.Customize_Reset}"
                    Icon="{ui:SymbolIcon ArrowReset24}" />
                <ui:Button
                    AutomationProperties.Name="{x:Static res:Strings.Customize_SaveName}"
                    Command="{Binding SaveProfileCommand}"
                    Content="{x:Static res:Strings.Customize_Save}"
                    Icon="{ui:SymbolIcon Save24}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource Plainstall.PageTitle}" Text="{x:Static res:Strings.Customize_Title}" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource Plainstall.PageSubtitle}"
                    Text="{Binding ChangedText}" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <TextBlock
                Margin="0,6,0,0"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource Plainstall.Result}"
                Tag="{Binding SaveFailed}"
                Text="{Binding SaveMessage}"
                Visibility="{Binding SaveMessage, Converter={StaticResource NullToCollapsed}}" />
            <Border
                Margin="0,8,0,0"
                Style="{StaticResource Plainstall.Notice}"
                Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ui:SymbolIcon Style="{StaticResource Plainstall.NoticeIcon}" Symbol="Info24" />
                    <ui:Button
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Static res:Strings.Customize_DismissMessages}"
                        Appearance="Transparent"
                        Command="{Binding DismissMessagesCommand}"
                        DockPanel.Dock="Right"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        ToolTip="{x:Static res:Strings.Customize_DismissMessages}" />
                    <ItemsControl
                        AutomationProperties.LiveSetting="Polite"
                        Focusable="False"
                        ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Plainstall.Bullet}" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </StackPanel>

        <TabControl
            Grid.Row="2"
            Margin="0,10,0,0"
            SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem AutomationProperties.Name="{x:Static res:Strings.Customize_TabApps}"
                     Header="{x:Static res:Strings.Customize_TabApps}">
                <views:CatalogListView DataContext="{Binding Apps}" />
            </TabItem>
            <TabItem AutomationProperties.Name="{x:Static res:Strings.Customize_TabTweaks}"
                     Header="{x:Static res:Strings.Customize_TabTweaks}">
                <views:CatalogListView DataContext="{Binding Tweaks}" />
            </TabItem>
            <TabItem AutomationProperties.Name="{x:Static res:Strings.Customize_TabSetup}"
                     Header="{x:Static res:Strings.Customize_TabSetup}">
                <views:SetupView DataContext="{Binding Setup}" />
            </TabItem>
            <TabItem AutomationProperties.Name="{x:Static res:Strings.Customize_TabAdvanced}"
                     Header="{x:Static res:Strings.Customize_TabAdvanced}">
                <views:AdvancedView DataContext="{Binding Advanced}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>