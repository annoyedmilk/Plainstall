<UserControl
    x:Class="Plainstall.App.Views.CatalogListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:Plainstall.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Plainstall.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:CatalogListViewModel}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Search and filters  -->
        <DockPanel Margin="0,10,0,8">
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                DockPanel.Dock="Right"
                Style="{StaticResource Plainstall.Secondary}"
                Text="{Binding ResultText}" />
            <CheckBox
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Static res:Strings.Filter_ChangedOnly}"
                Content="{x:Static res:Strings.Filter_ChangedOnly}"
                DockPanel.Dock="Right"
                IsChecked="{Binding ChangedOnly}" />
            <ComboBox
                MinWidth="160"
                Margin="12,0,0,0"
                AutomationProperties.Name="{x:Static res:Strings.Filter_RiskName}"
                DisplayMemberPath="Title"
                DockPanel.Dock="Right"
                ItemsSource="{Binding RiskFilters}"
                SelectedItem="{Binding SelectedRiskFilter}" />
            <ui:TextBox
                AutomationProperties.Name="{x:Static res:Strings.Filter_SearchName}"
                ClearButtonEnabled="True"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{x:Static res:Strings.Filter_SearchPlaceholder}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <ScrollViewer
            Grid.Row="1"
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,8">
                <Border
                    Margin="0,0,0,6"
                    Style="{StaticResource Plainstall.Notice}"
                    Visibility="{Binding ShowPolicyNotice, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <ui:SymbolIcon Style="{StaticResource Plainstall.NoticeIcon}" Symbol="Info24" />
                        <TextBlock Style="{StaticResource Plainstall.Body}"
                                   Text="{x:Static res:Strings.Customize_TweaksPolicyNotice}" />
                    </DockPanel>
                </Border>
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource Plainstall.Body}"
                    Text="{x:Static res:Strings.Filter_NoMatches}"
                    Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl Focusable="False" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryGroupViewModel}">
                            <StackPanel Margin="0,6,0,10"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Plainstall.SectionTitle}" Text="{Binding Title}" />
                                <TextBlock
                                    Margin="0,-4,0,6"
                                    Style="{StaticResource Plainstall.Secondary}"
                                    Text="{Binding Description}"
                                    Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding Visible}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="12,6"
                                                Style="{StaticResource Plainstall.Card}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <ui:ToggleSwitch
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.HelpText="{Binding Description}"
                                                        AutomationProperties.Name="{Binding SwitchName}"
                                                        IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                        OffContent="{Binding OffText}"
                                                        OnContent="{Binding OnText}" />
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,12,0">
                                                        <WrapPanel>
                                                            <TextBlock
                                                                Margin="0,0,10,0"
                                                                Style="{StaticResource Plainstall.Strong}"
                                                                Text="{Binding Title}" />
                                                            <StackPanel Orientation="Horizontal"
                                                                        Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibility}}">
                                                                <ui:SymbolIcon
                                                                    Margin="0,0,4,0"
                                                                    FontSize="14"
                                                                    Foreground="{DynamicResource Plainstall.AccentTextBrush}"
                                                                    Symbol="Edit24" />
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource Plainstall.AccentTextBrush}"
                                                                    Text="{x:Static res:Strings.Entry_ChangedMarker}" />
                                                            </StackPanel>
                                                        </WrapPanel>
                                                        <TextBlock Style="{StaticResource Plainstall.Secondary}"
                                                                   Text="{Binding Description}" />
                                                    </StackPanel>
                                                    <Border
                                                        Grid.Row="0"
                                                        Grid.Column="2"
                                                        Margin="0,0,8,0"
                                                        Style="{StaticResource Plainstall.RiskBadge}">
                                                        <TextBlock Style="{StaticResource Plainstall.RiskBadgeText}"
                                                                   Text="{Binding RiskText}" />
                                                    </Border>
                                                    <ToggleButton
                                                        Grid.Row="0"
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding DetailsButtonName}"
                                                        IsChecked="{Binding IsExpanded}"
                                                        ToolTip="{x:Static res:Strings.Entry_Details}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Margin="0,0,6,0"
                                                                       Text="{x:Static res:Strings.Entry_Details}" />
                                                            <ui:SymbolIcon FontSize="14" Symbol="ChevronDown24" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <Border
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Grid.ColumnSpan="3"
                                                        Margin="8,10,0,0"
                                                        Padding="12,8"
                                                        Background="{DynamicResource Plainstall.SubtleBrush}"
                                                        CornerRadius="6"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel>
                                                            <TextBlock
                                                                Margin="0,0,0,6"
                                                                Style="{StaticResource Plainstall.Body}"
                                                                Text="{Binding Details}"
                                                                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Style="{StaticResource Plainstall.Secondary}"
                                                                       Text="{Binding BuildRangeText}" />
                                                            <TextBlock
                                                                Style="{StaticResource Plainstall.Secondary}"
                                                                Text="{Binding ReinstallText}"
                                                                Visibility="{Binding ReinstallText, Converter={StaticResource NullToCollapsed}}" />
                                                            <TextBlock
                                                                Style="{StaticResource Plainstall.Secondary}"
                                                                Text="{Binding SourceText}"
                                                                Visibility="{Binding SourceText, Converter={StaticResource NullToCollapsed}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>