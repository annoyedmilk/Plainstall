<UserControl
    x:Class="Plainstall.App.Views.BuildPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:Plainstall.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Plainstall.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:BuildViewModel}"
    mc:Ignorable="d">
    <Grid Margin="32,12,32,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="0,0,0,10"
            Style="{StaticResource Plainstall.PageTitle}"
            Text="{x:Static res:Strings.Build_Title}" />

        <!--  Password, asked when the build starts  -->
        <ScrollViewer
            Grid.Row="1"
            Focusable="False"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding NeedsPassword, Converter={StaticResource BoolToVisibility}}">
            <Border
                MaxWidth="640"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource Plainstall.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Plainstall.SectionTitle}"
                               Text="{x:Static res:Strings.Build_PasswordTitle}" />
                    <TextBlock Style="{StaticResource Plainstall.Body}"
                               Text="{x:Static res:Strings.Build_PasswordText}" />
                    <Border Margin="0,10,0,0" Style="{StaticResource Plainstall.Notice.Caution}">
                        <DockPanel>
                            <ui:SymbolIcon Style="{StaticResource Plainstall.NoticeIcon}" Symbol="LockOpen24" />
                            <TextBlock Style="{StaticResource Plainstall.Body}"
                                       Text="{x:Static res:Strings.Build_PasswordWarning}" />
                        </DockPanel>
                    </Border>
                    <TextBlock
                        x:Name="PasswordLabel"
                        Margin="0,12,0,4"
                        Style="{StaticResource Plainstall.Body}"
                        Text="{x:Static res:Strings.Build_PasswordLabel}" />
                    <PasswordBox
                        x:Name="PasswordInput"
                        AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}"
                        AutomationProperties.Name="{x:Static res:Strings.Build_PasswordLabel}" />
                    <TextBlock
                        x:Name="ConfirmLabel"
                        Margin="0,10,0,4"
                        Style="{StaticResource Plainstall.Body}"
                        Text="{x:Static res:Strings.Build_PasswordConfirmLabel}" />
                    <PasswordBox
                        x:Name="ConfirmInput"
                        AutomationProperties.LabeledBy="{Binding ElementName=ConfirmLabel}"
                        AutomationProperties.Name="{x:Static res:Strings.Build_PasswordConfirmLabel}" />
                    <DockPanel Margin="0,6,0,0"
                               Visibility="{Binding PasswordError, Converter={StaticResource NullToCollapsed}}">
                        <ui:SymbolIcon
                            Margin="0,0,6,0"
                            Foreground="{DynamicResource Plainstall.DangerBrush}"
                            Symbol="ErrorCircle24" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Assertive"
                            FontWeight="SemiBold"
                            Style="{StaticResource Plainstall.Body}"
                            Text="{Binding PasswordError}" />
                    </DockPanel>
                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                        <ui:Button
                            AutomationProperties.Name="{x:Static res:Strings.Build_PasswordStart}"
                            Appearance="Primary"
                            Click="OnStartWithPassword"
                            Content="{x:Static res:Strings.Build_PasswordStart}"
                            IsDefault="True" />
                        <ui:Button
                            Margin="8,0,0,0"
                            AutomationProperties.Name="{x:Static res:Strings.Build_PasswordCancel}"
                            Command="{Binding CancelPasswordCommand}"
                            Content="{x:Static res:Strings.Build_PasswordCancel}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!--  Progress  -->
        <Grid Grid.Row="1" Visibility="{Binding NeedsPassword, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Plainstall.Card}">
                <ItemsControl
                    AutomationProperties.Name="{x:Static res:Strings.Build_StagesName}"
                    Focusable="False"
                    ItemsSource="{Binding Stages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StageViewModel}">
                            <Border
                                x:Name="Row"
                                Margin="0,1"
                                Padding="8,4"
                                AutomationProperties.Name="{Binding AutomationName}"
                                CornerRadius="4">
                                <DockPanel>
                                    <ui:SymbolIcon
                                        x:Name="Icon"
                                        Margin="0,0,10,0"
                                        FontSize="18"
                                        Foreground="{DynamicResource Plainstall.TextSecondaryBrush}"
                                        Symbol="Circle24" />
                                    <TextBlock
                                        x:Name="StateLabel"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        FontSize="12"
                                        Foreground="{DynamicResource Plainstall.TextSecondaryBrush}"
                                        Text="{Binding StateText}" />
                                    <TextBlock
                                        x:Name="Label"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Plainstall.Body}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Current">
                                    <Setter TargetName="Row" Property="Background"
                                            Value="{DynamicResource Plainstall.SubtleBrush}" />
                                    <Setter TargetName="Icon" Property="Symbol" Value="ArrowCircleRight24" />
                                    <Setter TargetName="Icon" Property="Filled" Value="True" />
                                    <Setter TargetName="Icon" Property="Foreground"
                                            Value="{DynamicResource Plainstall.AccentTextBrush}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                                    <Setter TargetName="StateLabel" Property="Foreground"
                                            Value="{DynamicResource Plainstall.TextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Done">
                                    <Setter TargetName="Icon" Property="Symbol" Value="CheckmarkCircle24" />
                                    <Setter TargetName="Icon" Property="Filled" Value="True" />
                                    <Setter TargetName="Icon" Property="Foreground"
                                            Value="{DynamicResource Plainstall.AccentTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Skipped">
                                    <Setter TargetName="Icon" Property="Symbol" Value="SubtractCircle24" />
                                    <Setter TargetName="Label" Property="Foreground"
                                            Value="{DynamicResource Plainstall.TextSecondaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                    <Setter TargetName="Icon" Property="Symbol" Value="DismissCircle24" />
                                    <Setter TargetName="Icon" Property="Filled" Value="True" />
                                    <Setter TargetName="Icon" Property="Foreground"
                                            Value="{DynamicResource Plainstall.DangerBrush}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Plainstall.Card}">
                    <StackPanel>
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource Plainstall.SectionTitle}"
                            Text="{Binding CurrentStageText}" />
                        <TextBlock
                            Style="{StaticResource Plainstall.Body}"
                            Text="{Binding CurrentAction}"
                            TextTrimming="CharacterEllipsis" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock
                                MinWidth="44"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Plainstall.Strong}"
                                Text="{Binding PercentText}"
                                TextAlignment="Right" />
                            <ProgressBar
                                Height="8"
                                AutomationProperties.Name="{Binding CurrentStageText}"
                                IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding PercentValue, Mode=OneWay}" />
                        </DockPanel>
                        <DockPanel Margin="0,14,0,0">
                            <ui:Button
                                AutomationProperties.Name="{x:Static res:Strings.Build_CancelName}"
                                Command="{Binding CancelCommand}"
                                Content="{x:Static res:Strings.Build_Cancel}"
                                Icon="{ui:SymbolIcon Stop24}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Assertive"
                                Style="{StaticResource Plainstall.Body}"
                                Text="{Binding StoppingText}"
                                Visibility="{Binding IsStopping, Converter={StaticResource BoolToVisibility}}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Expander
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{x:Static res:Strings.Build_ShowLog}"
                    Header="{x:Static res:Strings.Build_ShowLog}"
                    IsExpanded="{Binding IsLogExpanded}">
                    <ListBox
                        x:Name="LogList"
                        MaxHeight="260"
                        AutomationProperties.Name="{x:Static res:Strings.Build_LogName}"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        ItemsSource="{Binding LogLines}"
                        VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,1" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</UserControl>