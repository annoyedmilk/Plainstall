<UserControl
    x:Class="Plainstall.App.Views.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:Plainstall.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Plainstall.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ReviewViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="Bullet">
            <DockPanel Margin="0,1">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource Plainstall.Body}"
                    Text="&#x2022;" />
                <TextBlock Style="{StaticResource Plainstall.Body}" Text="{Binding}" />
            </DockPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="TwoColumns">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="32,12,32,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="11*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="9*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource Plainstall.PageTitle}" Text="{x:Static res:Strings.Review_Title}" />
            <TextBlock Style="{StaticResource Plainstall.PageSubtitle}" Text="{Binding WindowsText}" />
        </StackPanel>

        <!--  What the build will do  -->
        <ScrollViewer
            Grid.Row="1"
            Grid.Column="0"
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,8">
                <Border
                    Margin="0,0,0,12"
                    Style="{StaticResource Plainstall.Notice.Danger}"
                    Visibility="{Binding HasPlanErrors, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <ui:SymbolIcon Style="{StaticResource Plainstall.NoticeIcon.Danger}" Symbol="ErrorCircle24" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Plainstall.Strong}"
                                       Text="{x:Static res:Strings.Review_PlanErrorsTitle}" />
                            <ItemsControl
                                AutomationProperties.LiveSetting="Assertive"
                                Focusable="False"
                                ItemTemplate="{StaticResource Bullet}"
                                ItemsSource="{Binding PlanErrors}" />
                            <ui:Button
                                Margin="0,8,0,0"
                                AutomationProperties.Name="{x:Static res:Strings.Review_FixProblems}"
                                Command="{Binding FixProblemsCommand}"
                                Content="{x:Static res:Strings.Review_FixProblems}"
                                Icon="{ui:SymbolIcon ArrowLeft24}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Plainstall.Card}"
                        Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Plainstall.SectionTitle}" Text="{Binding RemovedAppsHeader}" />
                        <ItemsControl
                            Focusable="False"
                            ItemTemplate="{StaticResource Bullet}"
                            ItemsPanel="{StaticResource TwoColumns}"
                            ItemsSource="{Binding RemovedApps}" />
                    </StackPanel>
                </Border>
                <Border
                    Margin="0,12,0,0"
                    Style="{StaticResource Plainstall.Card}"
                    Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Plainstall.SectionTitle}" Text="{Binding ChangesHeader}" />
                        <ItemsControl
                            Focusable="False"
                            ItemTemplate="{StaticResource Bullet}"
                            ItemsPanel="{StaticResource TwoColumns}"
                            ItemsSource="{Binding Changes}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,12,0,0" Style="{StaticResource Plainstall.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Plainstall.SectionTitle}"
                                   Text="{x:Static res:Strings.Review_SetupHeader}" />
                        <ItemsControl
                            Focusable="False"
                            ItemTemplate="{StaticResource Bullet}"
                            ItemsSource="{Binding SetupLines}" />
                    </StackPanel>
                </Border>
                <Border
                    Margin="0,12,0,0"
                    Style="{StaticResource Plainstall.Card}"
                    Visibility="{Binding HasInstalls, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Plainstall.SectionTitle}"
                                   Text="{x:Static res:Strings.Review_InstallsHeader}" />
                        <ItemsControl
                            Focusable="False"
                            ItemTemplate="{StaticResource Bullet}"
                            ItemsPanel="{StaticResource TwoColumns}"
                            ItemsSource="{Binding Installs}" />
                    </StackPanel>
                </Border>
                <Border
                    Margin="0,12,0,0"
                    Style="{StaticResource Plainstall.Notice}"
                    Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <ui:SymbolIcon Style="{StaticResource Plainstall.NoticeIcon}" Symbol="Info24" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Plainstall.Strong}"
                                       Text="{x:Static res:Strings.Review_NotesHeader}" />
                            <ItemsControl
                                Focusable="False"
                                ItemTemplate="{StaticResource Bullet}"
                                ItemsSource="{Binding Notes}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Where it goes  -->
        <ScrollViewer
            Grid.Row="1"
            Grid.Column="2"
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,8">
                <Border Style="{StaticResource Plainstall.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Plainstall.SectionTitle}"
                                   Text="{x:Static res:Strings.Review_OutputHeader}" />

                        <CheckBox
                            AutomationProperties.Name="{x:Static res:Strings.Review_WantsUsb}"
                            Content="{x:Static res:Strings.Review_WantsUsb}"
                            IsChecked="{Binding WantsUsb}" />
                        <StackPanel Margin="28,6,0,0"
                                    Visibility="{Binding WantsUsb, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <ui:Button
                                    AutomationProperties.Name="{x:Static res:Strings.Review_RefreshUsbName}"
                                    Command="{Binding RefreshUsbCommand}"
                                    Content="{x:Static res:Strings.Review_RefreshUsb}"
                                    DockPanel.Dock="Right"
                                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
                                <TextBlock
                                    x:Name="StickLabel"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Plainstall.Body}"
                                    Text="{x:Static res:Strings.Review_PickStick}" />
                            </DockPanel>
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource Plainstall.Secondary}"
                                Text="{x:Static res:Strings.Review_NoSticks}"
                                Visibility="{Binding HasNoUsbCandidates, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource Plainstall.Body}"
                                Text="{Binding UsbError}"
                                Visibility="{Binding UsbError, Converter={StaticResource NullToCollapsed}}" />
                            <ListBox
                                Margin="0,6,0,0"
                                AutomationProperties.LabeledBy="{Binding ElementName=StickLabel}"
                                AutomationProperties.Name="{x:Static res:Strings.Review_PickStick}"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding UsbCandidates}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding SelectedUsb}">
                                <ListBox.ItemContainerStyle>
                                    <!--  Selection is a thick border and a tick, so the text keeps its colours and contrast.  -->
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="IsEnabled" Value="{Binding IsEligible}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                        <Setter Property="FocusVisualStyle"
                                                Value="{StaticResource Plainstall.FocusVisual}" />
                                        <Setter Property="Margin" Value="0,3" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border
                                                        x:Name="Box"
                                                        Padding="10,6"
                                                        Background="{DynamicResource Plainstall.CardSurfaceBrush}"
                                                        BorderBrush="{DynamicResource Plainstall.CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <DockPanel>
                                                            <ui:SymbolIcon
                                                                x:Name="Tick"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Top"
                                                                DockPanel.Dock="Right"
                                                                FontSize="20"
                                                                Filled="True"
                                                                Foreground="{DynamicResource Plainstall.AccentTextBrush}"
                                                                Symbol="CheckmarkCircle24"
                                                                Visibility="Hidden" />
                                                            <ContentPresenter />
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Box" Property="BorderBrush"
                                                                    Value="{DynamicResource Plainstall.AccentBrush}" />
                                                            <Setter TargetName="Box" Property="BorderThickness"
                                                                    Value="3" />
                                                            <Setter TargetName="Box" Property="Padding" Value="8,4" />
                                                            <Setter TargetName="Tick" Property="Visibility"
                                                                    Value="Visible" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Box" Property="Background"
                                                                    Value="{DynamicResource Plainstall.SubtleBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Box" Property="Opacity" Value="0.72" />
                                                            <Setter TargetName="Box" Property="BorderBrush"
                                                                    Value="Transparent" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:UsbCandidateViewModel}">
                                        <DockPanel>
                                            <ui:SymbolIcon
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Top"
                                                FontSize="22"
                                                Symbol="UsbStick24" />
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Plainstall.Strong}">
                                                    <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  " />
                                                    <Run Text="{Binding SizeText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Plainstall.Secondary}"
                                                           Text="{Binding VolumesText}" />
                                                <TextBlock
                                                    Style="{StaticResource Plainstall.Secondary}"
                                                    Text="{Binding ExternalNoteText}"
                                                    Visibility="{Binding ExternalNoteText, Converter={StaticResource NullToCollapsed}}" />
                                                <TextBlock
                                                    Style="{StaticResource Plainstall.Secondary}"
                                                    Text="{Binding ReasonText}"
                                                    Visibility="{Binding ReasonText, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!--  Erasing needs an explicit yes that names the stick.  -->
                            <Border
                                Margin="0,8,0,0"
                                Style="{StaticResource Plainstall.Notice.Danger}"
                                Visibility="{Binding HasSelectedUsb, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <ui:SymbolIcon Style="{StaticResource Plainstall.NoticeIcon.Danger}"
                                                   Symbol="Warning24" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Plainstall.Strong}"
                                                   Text="{x:Static res:Strings.Review_EraseTitle}" />
                                        <TextBlock
                                            AutomationProperties.LiveSetting="Assertive"
                                            Style="{StaticResource Plainstall.Body}"
                                            Text="{Binding EraseConfirmText}" />
                                        <!--  A disk Windows reports as an external drive needs one more yes, first.  -->
                                        <CheckBox
                                            Margin="0,8,0,0"
                                            AutomationProperties.Name="{x:Static res:Strings.Review_ExternalCheckbox}"
                                            Content="{x:Static res:Strings.Review_ExternalCheckbox}"
                                            IsChecked="{Binding ExternalDriveConfirmed}"
                                            Visibility="{Binding NeedsExternalConfirmation, Converter={StaticResource BoolToVisibility}}" />
                                        <CheckBox
                                            Margin="0,8,0,0"
                                            AutomationProperties.HelpText="{Binding EraseConfirmText}"
                                            AutomationProperties.Name="{x:Static res:Strings.Review_EraseCheckbox}"
                                            Content="{x:Static res:Strings.Review_EraseCheckbox}"
                                            IsChecked="{Binding EraseConfirmed}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <CheckBox
                            Margin="0,12,0,0"
                            AutomationProperties.Name="{x:Static res:Strings.Review_WantsIso}"
                            Content="{x:Static res:Strings.Review_WantsIso}"
                            IsChecked="{Binding WantsIso}" />
                        <DockPanel Margin="28,6,0,0"
                                   Visibility="{Binding WantsIso, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button
                                Margin="8,0,0,0"
                                AutomationProperties.Name="{x:Static res:Strings.Review_ChooseIsoName}"
                                Command="{Binding ChooseIsoOutputCommand}"
                                Content="{x:Static res:Strings.Review_ChooseIso}"
                                DockPanel.Dock="Right"
                                Icon="{ui:SymbolIcon Save24}" />
                            <ui:TextBox
                                AutomationProperties.Name="{x:Static res:Strings.Review_IsoPathName}"
                                IsReadOnly="True"
                                PlaceholderText="{x:Static res:Strings.Review_IsoPlaceholder}"
                                Text="{Binding IsoOutputPath, Mode=OneWay}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource Plainstall.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Plainstall.SectionTitle}"
                                   Text="{x:Static res:Strings.Review_SpaceHeader}" />
                        <TextBlock Style="{StaticResource Plainstall.Body}" Text="{Binding SpaceText}" />
                        <DockPanel Margin="0,6,0,0">
                            <ui:Button
                                Margin="8,0,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{x:Static res:Strings.Review_ChangeWorkFolderName}"
                                Command="{Binding ChangeWorkFolderCommand}"
                                Content="{x:Static res:Strings.Review_ChangeWorkFolder}"
                                DockPanel.Dock="Right" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource Plainstall.Secondary}"
                                Text="{Binding WorkFolder}" />
                        </DockPanel>
                        <Border
                            Margin="0,8,0,0"
                            Style="{StaticResource Plainstall.Notice.Danger}"
                            Visibility="{Binding HasSpaceProblems, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <ui:SymbolIcon Style="{StaticResource Plainstall.NoticeIcon.Danger}"
                                               Symbol="ErrorCircle24" />
                                <ItemsControl
                                    AutomationProperties.LiveSetting="Assertive"
                                    Focusable="False"
                                    ItemTemplate="{StaticResource Bullet}"
                                    ItemsSource="{Binding SpaceProblems}" />
                            </DockPanel>
                        </Border>
                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource Plainstall.Strong}"
                            Text="{x:Static res:Strings.Review_TimeHeader}" />
                        <TextBlock Style="{StaticResource Plainstall.Body}" Text="{Binding TimeText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>