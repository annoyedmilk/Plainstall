<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>Plainstall.Core.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <!-- LibraryImport generates its marshalling code as unsafe code. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Plainstall.Core\Plainstall.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JsonSchema.Net"/>
        <PackageReference Include="xunit.v3"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The catalog files and the schemas live next to the code that owns them; tests read copies from the output folder. -->
        <None Include="$(RepoRoot)src\Plainstall.Core\Catalog\Data\*.schema.json" Link="Schemas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="$(RepoRoot)src\Plainstall.Core\Profiles\*.schema.json" Link="Schemas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="$(RepoRoot)src\Plainstall.Core\Catalog\Data\*.json" Exclude="$(RepoRoot)src\Plainstall.Core\Catalog\Data\*.schema.json" Link="CatalogFiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>
